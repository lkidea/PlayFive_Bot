# Registered Playfive account (REQUIRED)
PLAYFIVE_USERNAME=YourBotNick
PLAYFIVE_PASSWORD=YourBotPassword

# Two separate Discord webhooks (REQUIRED)
DISCORD_WEBHOOK_CHAT=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_TABLE=https://discord.com/api/webhooks/...

# Optional: Discord Role IDs (digits only) to ping on alerts
DISCORD_CHAT_PING_ROLE_ID=
DISCORD_TABLE_PING_ROLE_ID=

# Optional tuning (defaults shown)
PLAYFIVE_BASE_URL=http://www.playfive.net
CHAT_TRIGGER=Discord notif pls
CHAT_COOLDOWN_SECONDS=60
IGNORE_SELF_CHAT=false
WAIT_THRESHOLD_SECONDS=180
TABLE_COOLDOWN_SECONDS=300
IGNORED_NICKS=xobot
INCLUDE_TEACHING=true
RECONNECT_BACKOFF_MINUTES=5,15,30,60
DEBUG_XMPP=false
